# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model alias or name for Gemini provider (default: gemini-3.7-flash)
GEMINI_MODEL="gemini-3.7-flash"

# OPENAI_API_KEY: Optional API key for OpenAI provider
OPENAI_API_KEY=""

# OPENAI_MODEL: Model name for OpenAI provider (default: gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# DEFAULT_AI_PROVIDER: Default active provider (gemini or openai)
DEFAULT_AI_PROVIDER="gemini"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

